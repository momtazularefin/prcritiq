# PRCritiq production configuration for the Hetzner node (ADR-019).
#
# Copy to /opt/prcritiq/.env on the server, fill in, and `chmod 600` it.
# Never commit the filled-in file. deploy.sh links it into each release.

# Routing and TLS
PRCRITIQ_DOMAIN=prcritiq.arefin.app
PRCRITIQ_PUBLIC_BASE_URL=https://prcritiq.arefin.app

# Run store. Generate once with: openssl rand -hex 24
POSTGRES_PASSWORD=

# GitHub App (Settings > Developer settings > GitHub Apps).
# The private key goes on one line, with each line break written as \n.
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=

# Token the public demo reads with. Use a fine-grained token limited to public
# repositories, read-only; then a private repository is unreadable to the demo
# regardless of the app-level guard. Blank means anonymous (60 requests/hour).
GITHUB_TOKEN=

# Safety switches. These are the defaults, written out so a reader of this
# file sees them. Webhook runs are always dry-run and never post.
PRCRITIQ_WEBHOOK_REVIEW=false
PRCRITIQ_ALLOW_PRIVATE_REPOS=false
PRCRITIQ_DEMO_ENABLED=true
PRCRITIQ_DEMO_REQUESTS_PER_MINUTE=6

# Model review for webhook runs is off. Setting PRCRITIQ_WEBHOOK_REVIEW=true
# spends model credit on every accepted pull_request event and needs a key:
ANTHROPIC_API_KEY=
PRCRITIQ_ANTHROPIC_MODEL=claude-opus-5
PRCRITIQ_MODEL_EFFORT=low

PRCRITIQ_TRACE_PROVIDER=none
