# PRCritiq local configuration.
# Copy to .env for local use. Never commit .env.

PRCRITIQ_ENV=local
PRCRITIQ_PUBLIC_BASE_URL=http://localhost:8000
PRCRITIQ_DEFAULT_MODE=dry-run
PRCRITIQ_MODEL_POLICY=auto
PRCRITIQ_MAX_FILES=30
PRCRITIQ_MAX_DIFF_LINES=2000
PRCRITIQ_MAX_FILE_BYTES=250000
PRCRITIQ_MIN_PUBLISH_CONFIDENCE=78
PRCRITIQ_TRACE_PROVIDER=none
ACCELERATION=none

# Secrets are intentionally blank here.
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DATABASE_URL=
LANGSMITH_API_KEY=
