# PRCritiq local configuration.
# Copy to .env for local use. Never commit .env.

PRCRITIQ_ENV=local
PRCRITIQ_PUBLIC_BASE_URL=http://localhost:8000
PRCRITIQ_DEFAULT_MODE=dry-run
PRCRITIQ_MODEL_POLICY=auto
PRCRITIQ_MAX_FILES=30
PRCRITIQ_MAX_DIFF_LINES=2000
PRCRITIQ_MAX_FILE_BYTES=250000
PRCRITIQ_MIN_PUBLISH_CONFIDENCE=78
PRCRITIQ_TRACE_PROVIDER=none
ACCELERATION=none

# Secrets are intentionally blank here.
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_REQUEST_TIMEOUT_SECONDS=15
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DATABASE_URL=
LANGSMITH_API_KEY=

# Retrieval
PRCRITIQ_SIMILARITY=lexical
PRCRITIQ_MAX_CONTEXT_CHUNKS=24
PRCRITIQ_MAX_CONTEXT_BYTES=200000
PRCRITIQ_MAX_ARCHIVE_FILES=20000
PRCRITIQ_MAX_ARCHIVE_BYTES=80000000
